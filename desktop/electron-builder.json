{
  "appId": "local.agentworkbench",
  "productName": "Agent Workbench",
  "directories": {
    "output": "release"
  },
  "files": [
    "desktop/main.mjs",
    "desktop/preload.cjs",
    "desktop/renderer-next/out/**/*",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/webview{,/**/*}",
    "!**/node_modules/monaco-editor{,/**/*}",
    "!**/node_modules/@xterm{,/**/*}",
    "!**/node_modules/markdown-it{,/**/*}",
    "!**/node_modules/react{,/**/*}",
    "!**/node_modules/react-dom{,/**/*}"
  ],
  "extraMetadata": {
    "main": "desktop/main.mjs"
  },
  "asar": true,
  "npmRebuild": false,
  "asarUnpack": [
    "node_modules/node-pty/**"
  ],
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage"
  }
}
